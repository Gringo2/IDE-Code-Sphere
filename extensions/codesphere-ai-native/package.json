{
    "name": "codesphere-ai-native",
    "publisher": "codesphere",
    "version": "0.0.1",
    "displayName": "CodeSphere AI Native",
    "description": "Deeply integrated AI capabilities for CodeSphere.",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codesphere.ai.helloWorld",
                "title": "CodeSphere AI: Hello World"
            },
            {
                "command": "codesphere.ai.setOpenRouterKey",
                "title": "CodeSphere AI: Set OpenRouter API Key"
            },
            {
                "command": "codesphere.ai.resetOpenRouterConsent",
                "title": "CodeSphere AI: Reset OpenRouter Consent"
            }
        ],
        "configuration": {
            "title": "CodeSphere AI",
            "properties": {
                "codesphere.ai.openRouterModel": {
                    "type": "string",
                    "default": "openai/gpt-oss-120b",
                    "description": "OpenRouter model id used by CodeSphere AI chat."
                }
            }
        },
        "viewContainers": {
            "activitybar": [
                {
                    "id": "codesphere-ai-sidebar",
                    "title": "CodeSphere AI",
                    "icon": "$(sparkle)"
                }
            ]
        },
        "views": {
            "codesphere-ai-sidebar": [
                {
                    "id": "codesphere.ai.chat",
                    "name": "AI Chat",
                    "type": "webview",
                    "icon": "$(comment-discussion)"
                },
                {
                    "id": "codesphere.ai.context",
                    "name": "Context Manager",
                    "type": "webview",
                    "icon": "$(references)"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src --ext ts",
        "test:unit": "mocha -r ts-node/register src/__tests__/**/*.test.ts",
        "build:webview": "cd webview-ui && npm install && npm run build"
    },
    "enabledApiProposals": [
        "inlineCompletionsAdditions",
        "terminalDataWriteEvent"
    ],
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "18.x",
        "@types/vscode": "1.90.0",
        "@typescript-eslint/eslint-plugin": "^7.11.0",
        "@typescript-eslint/parser": "^7.11.0",
        "@vscode/test-electron": "^2.5.2",
        "chai": "^6.2.2",
        "esbuild": "^0.21.5",
        "eslint": "^8.57.0",
        "glob": "^13.0.6",
        "mocha": "^11.7.5",
        "mocha-multi-reporters": "^1.5.1",
        "npm-run-all": "^4.1.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "zod": "^4.4.1"
    }
}
